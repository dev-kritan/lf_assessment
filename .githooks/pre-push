#!/usr/bin/env bash

# ==============================================================================
# Git Pre-Push Hook: Automated Testing Suite
# ==============================================================================
# This hook runs before 'git push'. If any backend or frontend tests fail,
# the push is automatically aborted. Only pushes with 100% passing tests proceed.
# ==============================================================================

# Styling helpers
BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

echo ""
echo -e "${CYAN}${BOLD}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}${BOLD}║                GIT PRE-PUSH TEST RUNNER                      ║${NC}"
echo -e "${CYAN}${BOLD}╚══════════════════════════════════════════════════════════════╝${NC}"
echo -e "${YELLOW}⚡ Running all test suites before allowing git push...${NC}"
echo ""

# Find repository root directory
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  REPO_ROOT="$(pwd)"
fi

cd "$REPO_ROOT" || exit 1

# ------------------------------------------------------------------------------
# 1. Backend Tests (Jest / Supertest / SQLite in-memory)
# ------------------------------------------------------------------------------
echo -e "${CYAN}▶ [1/2] Running Backend Tests (Jest)...${NC}"
npm run test:backend

BACKEND_STATUS=$?
if [ $BACKEND_STATUS -ne 0 ]; then
  echo ""
  echo -e "${RED}${BOLD}❌ BACKEND TESTS FAILED (Exit Code: $BACKEND_STATUS)${NC}"
  echo -e "${RED}🚫 Push aborted! Please fix the backend test errors before pushing.${NC}"
  echo ""
  exit 1
fi
echo -e "${GREEN}✔ Backend tests passed successfully!${NC}"
echo ""

# ------------------------------------------------------------------------------
# 2. Frontend Tests (Vitest / React Testing Library)
# ------------------------------------------------------------------------------
echo -e "${CYAN}▶ [2/2] Running Frontend Tests (Vitest)...${NC}"
npm run test:frontend

FRONTEND_STATUS=$?
if [ $FRONTEND_STATUS -ne 0 ]; then
  echo ""
  echo -e "${RED}${BOLD}❌ FRONTEND TESTS FAILED (Exit Code: $FRONTEND_STATUS)${NC}"
  echo -e "${RED}🚫 Push aborted! Please fix the frontend test errors before pushing.${NC}"
  echo ""
  exit 1
fi
echo -e "${GREEN}✔ Frontend tests passed successfully!${NC}"
echo ""

# ------------------------------------------------------------------------------
# Success: All Tests Passed
# ------------------------------------------------------------------------------
echo -e "${GREEN}${BOLD}════════════════════════════════════════════════════════════════${NC}"
echo -e "${GREEN}${BOLD}🎉 ALL TESTS PASSED (Backend + Frontend)! PROCEEDING WITH PUSH.${NC}"
echo -e "${GREEN}${BOLD}════════════════════════════════════════════════════════════════${NC}"
echo ""

exit 0
